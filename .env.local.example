# --- Firebase (auth + content database) ---
# Firebase Console → Project settings → Your apps → Web app → SDK setup
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Cloudinary (image hosting) ---
# Cloudinary Console → Settings → API Keys. The cloud name is public; the key
# and secret are server-only and must NOT be prefixed with NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: top-level Cloudinary folder everything is uploaded into.
# Defaults to "arditransportation"; photos land in <root>/gallery and <root>/fleet.
# Changing this does NOT move photos already uploaded — their URLs are stored
# in Firestore and keep working from the old folder.
CLOUDINARY_ROOT_FOLDER=

# --- Firebase service account (server-only) ---
# Required for the Users screen and for image uploads. Firebase Console →
# Project settings → Service accounts → Generate new private key.
#
# Paste the whole JSON, minified to one line:
#   jq -c . serviceAccount.json
# Base64 is also accepted, but it is ~33% larger — only use it if your host
# mangles the value:
#   base64 -i serviceAccount.json | tr -d '\n'
#
# This is a REAL secret — it bypasses every security rule. Never prefix it with
# NEXT_PUBLIC_, and never commit it.
FIREBASE_SERVICE_ACCOUNT=

# Alternative to the above, for hosts that cap the COMBINED size of all
# environment variables (AWS Lambda allows 4 KB total; the full JSON is ~2.4 KB,
# or ~3.2 KB base64). These three fields are all that is actually used, ~1.9 KB.
# Set either FIREBASE_SERVICE_ACCOUNT or all three of these, not both.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Public website origin. Used for the "View site" link and to preview images
# that still live in the site's /public folder.
NEXT_PUBLIC_SITE_URL=http://localhost:3737

# Optional: lets a save clear the website's cache immediately instead of
# waiting out its 60-second revalidation window. Must match REVALIDATE_SECRET
# in the website project. Note this value ships to the browser, so it only
# guards against casual cache-busting — treat it as a nuisance filter, not a
# credential.
NEXT_PUBLIC_SITE_REVALIDATE_URL=http://localhost:3737/api/revalidate
NEXT_PUBLIC_SITE_REVALIDATE_SECRET=
